# Copy to .env and fill in. Don't commit .env.

# Gemini — for the video extractor (reuse the key from extractor-test/)
GEMINI_API_KEY=

# Google Places API — for the resolver (reuse from extractor-test/)
GOOGLE_PLACES_API_KEY=

# Telegram bot — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use this bot.
# Find yours by DM'ing @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=

# Verify that webhook requests came from Telegram. Generate a private random value.
TELEGRAM_WEBHOOK_SECRET=

# Bearer token for POST /api/v1/ingests. Do not reuse the Telegram token.
INGEST_API_TOKEN=

# Optional Telegram destination for Shortcut API results. Defaults to the first
# TELEGRAM_ALLOWED_USER_IDS value when omitted.
SHORTCUT_TELEGRAM_CHAT_ID=

# The public URL pointing at this backend. In dev:
#   cloudflared tunnel --url http://localhost:8000
# copy the https://....trycloudflare.com URL it prints into here.
PUBLIC_URL=

# Optional overrides
PORT=8000
GEMINI_MODEL=gemini-3.1-flash-lite
