# Copy to .env and fill in. Don't commit .env.

# Gemini — for the video extractor (reuse the key from extractor-test/)
GEMINI_API_KEY=

# Google Places API — for the resolver (reuse from extractor-test/)
GOOGLE_PLACES_API_KEY=

# Bearer token for POST /api/v1/ingests.
INGEST_API_TOKEN=

# Optional overrides
PORT=8000
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional descriptive identifier for Wikidata requests. Read access needs no key.
WIKIDATA_USER_AGENT=PlaceLogger/1.0 (https://github.com/natcasd/place-logging)
